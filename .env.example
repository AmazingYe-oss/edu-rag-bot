# ==========================================
# Edu RAG 配置文件模板 (.env.example)
# ⚠️ 请将此文件复制并重命名为 .env，然后填入你自己的真实密钥
# ==========================================

# 1. 阿里云通义千问大模型 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 2. 阿里云 OSS 配置 (用于文件存储)
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your_bucket_name

# 3. 阿里云 Redis 配置 (用于流式限流与短期记忆缓存)
REDIS_HOST=your_redis_host_ip
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# 4. 阿里云 DashVector 向量数据库 (用于知识库检索)
DASHVECTOR_API_KEY=your_dashvector_api_key
DASHVECTOR_ENDPOINT=your_dashvector_endpoint
